# Environment variables for RetailAI Research Agent

# API Config
API_HOST=0.0.0.0
API_PORT=8000

# LLM Providers (Add keys as needed)
OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database
DATABASE_URL=sqlite:///./data/sqlite/retailai.db

# Vector DB (Chroma)
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
